# ===== Sao chép file này thành .env rồi điền giá trị =====

# PostgreSQL 16 + pgvector (Docker Compose tự đặt giá trị này)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dental_rag

# --- Claude API (bắt buộc để AI soạn câu trả lời) ---
# Lấy tại https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Độ sâu suy luận: low | medium | high | xhigh | max
CLAUDE_EFFORT_DOCTOR=high
CLAUDE_EFFORT_PATIENT=medium

# --- Embedding (tìm kiếm ngữ nghĩa) ---
# auto = dùng OpenAI nếu có key, ngược lại dùng bộ offline "local"
# Khuyến nghị dùng OpenAI (text-embedding-3-small, chi phí rất thấp) để tìm kiếm chính xác hơn.
# SAU KHI ĐỔI nhà cung cấp phải chạy lại: python -m dental_ai reindex
EMBEDDING_PROVIDER=auto
OPENAI_API_KEY=

# --- Fallback y văn PubMed 2016–2026 ---
FALLBACK_ENABLED=true
# Khuyến nghị đăng ký API key miễn phí tại https://www.ncbi.nlm.nih.gov/account/ (tăng giới hạn truy vấn)
NCBI_API_KEY=
NCBI_EMAIL=

# --- Quản trị: mật khẩu cho /api/admin/* (đặt chuỗi dài, ngẫu nhiên) ---
ADMIN_TOKEN=
